# =============================================================================
# Makefile — Kbuild for the proc/sys/debugfs teaching module.
# =============================================================================
#
# This is a KERNEL MODULE, so the build is driven by the kernel's own Kbuild
# system, NOT by a normal compile of a .c into a binary. The magic line is:
#
#     obj-m := proc_sys_debugfs.o
#
# which tells Kbuild "build one loadable module from proc_sys_debugfs.c". Kbuild
# derives the module name (proc_sys_debugfs.ko) from that object name.
#
# The `make` target below re-invokes make INSIDE the kernel build tree:
#
#     make -C /lib/modules/$(uname -r)/build M=$(PWD) modules
#            ^ -C: cd into the kernel headers/build dir for the running kernel
#                                        ^ M=$(PWD): but build the module that
#                                          lives in THIS directory
#
# You MUST run this on Linux (or WSL2 / a QEMU VM) with matching kernel headers
# installed (package: linux-headers-$(uname -r) on Debian/Ubuntu). It cannot and
# will not build on the Windows host this repo may be edited from — see README.
#
# The teaching ASSEMBLY (asm/demo.*.s) is host-portable and is regenerated by the
# `make asm` target with a cross-targeting clang; that works anywhere clang runs.
# =============================================================================

# ----- part 1: the Kbuild fragment (used when Kbuild re-enters this file) -----
# When `make -C .../build M=$(PWD)` runs, the kernel build system includes this
# Makefile with KERNELRELEASE set, and only this one assignment matters.
obj-m := proc_sys_debugfs.o

# ----- part 2: the convenience wrapper (used when you type plain `make`) ------
# KDIR points at the build tree of the currently running kernel.
KDIR ?= /lib/modules/$(shell uname -r)/build
PWD  := $(shell pwd)

# For asm regeneration we force the Linux System V target so the output matches
# the ABI every project in this repo assumes, regardless of the host OS.
ASM_TARGET ?= x86_64-pc-linux-gnu
ASM_FLAGS  := -fno-asynchronous-unwind-tables -fno-jump-tables -fno-omit-frame-pointer

.PHONY: all
all:
	$(MAKE) -C $(KDIR) M=$(PWD) modules
	@echo "built proc_sys_debugfs.ko — load it with:  sudo insmod proc_sys_debugfs.ko"

# Regenerate the committed teaching assembly from asm/demo.c. The hand-written
# asm/demo.annotated.s is NOT overwritten — it is authored by hand.
.PHONY: asm
asm:
	clang --target=$(ASM_TARGET) -S -O0 $(ASM_FLAGS) asm/demo.c -o asm/demo.O0.s
	clang --target=$(ASM_TARGET) -S -O1 $(ASM_FLAGS) asm/demo.c -o asm/demo.s
	clang --target=$(ASM_TARGET) -S -O2 -fno-asynchronous-unwind-tables -fno-jump-tables asm/demo.c -o asm/demo.O2.s
	@echo "regenerated asm/demo.{O0.s,s,O2.s} — asm/demo.annotated.s is hand-authored"

# Load / unload / inspect helpers (Linux only; need root for insmod/rmmod).
.PHONY: load
load: all
	sudo insmod proc_sys_debugfs.ko
	@echo "loaded. try:  cat /proc/psd_demo ; ls /sys/kernel/psd_demo/ ; sudo ls /sys/kernel/debug/psd_demo/"

.PHONY: unload
unload:
	sudo rmmod proc_sys_debugfs

.PHONY: clean
clean:
	$(MAKE) -C $(KDIR) M=$(PWD) clean
