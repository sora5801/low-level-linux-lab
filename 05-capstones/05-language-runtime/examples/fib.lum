// fib.lum — recursion + a native timer. Shows call frames and the `clock()`
// builtin. Run with:  ./lumen examples/fib.lum
fun fib(n) {
  if (n < 2) return n;
  return fib(n - 1) + fib(n - 2);
}

var start = clock();
print fib(25);                 // 75025
var elapsed = clock() - start;
print "elapsed seconds:";
print elapsed;
