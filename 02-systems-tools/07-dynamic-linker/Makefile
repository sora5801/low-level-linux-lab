# =============================================================================
# Makefile — the toy dynamic linker/loader and its self-contained test targets.
#
# PLATFORM: the loader itself and the test programs RUN only on Linux/WSL (they
# use raw Linux syscalls and ELF). The teaching *assembly* under asm/ is
# regenerated by a cross-targeting clang and works on any host (`make asm`).
# =============================================================================

CC     ?= clang
# The loader is freestanding by necessity — it is what sets up libc, so it can
# use none. Same flag set as the nolibc reference project:
#   -nostdlib  : no CRT/libc; we provide _start and memset/memcpy ourselves.
#   -static    : the loader must not itself need a dynamic loader.
#   -no-pie    : load at a fixed address, so the loader needs no self-relocation
#                before it can run (it bootstraps the loaded program, not itself).
LDR_CFLAGS ?= -Wall -Wextra -O2 -nostdlib -static -no-pie \
              -fno-stack-protector -ffreestanding

# Force the Linux System V AMD64 target for asm generation regardless of host.
ASM_TARGET ?= x86_64-pc-linux-gnu
ASMFLAGS   := --target=$(ASM_TARGET) -S -fno-asynchronous-unwind-tables \
              -fno-jump-tables

# --- default: build the loader -----------------------------------------------
loader: loader.c
	$(CC) $(LDR_CFLAGS) $< -o $@
	@echo "built ./loader — run:  ./loader ./test/hello-pie"

# --- test target #1: a freestanding shared object (libgreet.so) --------------
# -fPIC + -shared makes an ET_DYN with a DT_SONAME; --hash-style=both ships a
# Sys V DT_HASH (which our loader uses for its symbol count) alongside GNU hash.
test/libgreet.so: test/greetlib.c
	$(CC) -O2 -fPIC -nostdlib -shared -fno-stack-protector \
	      -Wl,--hash-style=both -Wl,-soname,libgreet.so $< -o $@

# --- test target #2: a dynamic executable that NEEDs libgreet.so -------------
# -pie makes an ET_DYN executable; linking against -lgreet records a DT_NEEDED
# of libgreet.so and JUMP_SLOT / GLOB_DAT relocations for its symbols.
test/prog: test/prog.c test/libgreet.so
	$(CC) -O2 -fPIE -nostdlib -pie -fno-stack-protector \
	      -Wl,--hash-style=both test/prog.c -Ltest -lgreet -o $@

# --- test target #3: a static-PIE (no dependencies, only RELATIVE relocs) ----
test/hello-pie: test/hello-pie.c
	$(CC) -O2 -fPIE -static-pie -nostdlib -fno-stack-protector $< -o $@

.PHONY: test
test: loader test/hello-pie test/prog
	@echo "== 1) static-PIE, no symbols, just R_X86_64_RELATIVE/RELR =="
	./loader ./test/hello-pie
	@echo
	@echo "== 2) dynamic exe + libgreet.so: JUMP_SLOT/GLOB_DAT/init_array =="
	LDLAB_LIBRARY_PATH=test ./loader ./test/prog
	@echo
	@echo "(set LDLAB_DEBUG=1 to watch every step the loader takes)"

# --- teaching assembly -------------------------------------------------------
# Regenerate the committed .s with the EXACT commands from the lab spec. The
# hand-written asm/demo.annotated.s is authored and NOT overwritten here.
.PHONY: asm
asm:
	$(CC) $(ASMFLAGS) -O0 -fno-omit-frame-pointer asm/demo.c   -o asm/demo.O0.s
	$(CC) $(ASMFLAGS) -O1 -fno-omit-frame-pointer asm/demo.c   -o asm/demo.s
	$(CC) $(ASMFLAGS) -O2                         asm/demo.c   -o asm/demo.O2.s
	$(CC) $(ASMFLAGS) -O0 -fno-omit-frame-pointer loader.c     -o asm/loader.O0.s
	$(CC) $(ASMFLAGS) -O1 -fno-omit-frame-pointer loader.c     -o asm/loader.s
	$(CC) $(ASMFLAGS) -O2                         loader.c     -o asm/loader.O2.s
	@echo "regenerated asm/{demo,loader}.{O0.s,s,O2.s}"

.PHONY: clean
clean:
	rm -f loader test/prog test/hello-pie test/libgreet.so
